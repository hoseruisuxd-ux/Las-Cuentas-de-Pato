rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    // --- Entity Validation Blueprints ---
    function isValidClient(data, userId) {
      return data.keys().hasAll([
               'userId', 'fullName', 'paymentModality', 'agreedPrice', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'fullName', 'phone', 'address', 'paymentModality', 'agreedPrice', 'notes', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             isValidOptionalString(data, 'phone', 30) &&
             isValidOptionalString(data, 'address', 200) &&
             isValidOptionalString(data, 'notes', 300) &&
             data.paymentModality in ['DIARIO', 'SEMANAL', 'QUINCENAL', 'MENSUAL'] &&
             data.agreedPrice is int && data.agreedPrice >= 1 && data.agreedPrice <= 10000000 &&
             data.status in ['ACTIVO', 'INACTIVO'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidLunchEntry(data, userId) {
      return data.keys().hasAll([
               'userId', 'clientId', 'clientNameSnapshot', 'dateEpochDay',
               'quantity', 'unitPrice', 'totalAmount', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'clientId', 'clientNameSnapshot', 'dateEpochDay',
               'quantity', 'unitPrice', 'totalAmount', 'note', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             isValidId(data.clientId) &&
             data.clientNameSnapshot is string && data.clientNameSnapshot.size() >= 1 && data.clientNameSnapshot.size() <= 100 &&
             data.dateEpochDay is int && data.dateEpochDay >= 18000 && data.dateEpochDay <= 50000 &&
             data.quantity is int && data.quantity >= 1 && data.quantity <= 500 &&
             data.unitPrice is int && data.unitPrice >= 1 && data.unitPrice <= 10000000 &&
             data.totalAmount is int && data.totalAmount == (data.quantity * data.unitPrice) &&
             isValidOptionalString(data, 'note', 250) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPaymentRecord(data, userId) {
      return data.keys().hasAll([
               'userId', 'clientId', 'clientNameSnapshot', 'dateEpochDay',
               'amount', 'method', 'paymentType', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'clientId', 'clientNameSnapshot', 'dateEpochDay',
               'amount', 'method', 'paymentType', 'note', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             isValidId(data.clientId) &&
             data.clientNameSnapshot is string && data.clientNameSnapshot.size() >= 1 && data.clientNameSnapshot.size() <= 100 &&
             data.dateEpochDay is int && data.dateEpochDay >= 18000 && data.dateEpochDay <= 50000 &&
             data.amount is int && data.amount >= 1 && data.amount <= 50000000 &&
             data.method in ['EFECTIVO', 'NEQUI', 'TRANSFERENCIA', 'DAVIPLATA', 'OTRO'] &&
             data.paymentType in ['TOTAL', 'ABONO'] &&
             isValidOptionalString(data, 'note', 250) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- Collection Rules ---
    match /users/{userId} {
      // Subcollection: Clients (contains PII like phone/address -> owner-only)
      match /clients/{clientId} {
        allow get: if isOwner(userId) && isValidId(clientId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(clientId) &&
                         isValidClient(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(clientId) &&
                         isValidClient(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt && (
                           // Action: Toggle status only
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
                           // Action: Edit client details
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'fullName', 'phone', 'address', 'paymentModality', 'agreedPrice', 'notes', 'status', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(clientId);
      }

      // Subcollection: Daily Lunch Entries
      match /lunch_entries/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidLunchEntry(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/clients/$(incoming().clientId));

        allow update: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidLunchEntry(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().clientId == existing().clientId &&
                         incoming().createdAt == existing().createdAt && (
                           // Action: Edit lunch entry details
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'dateEpochDay', 'quantity', 'unitPrice', 'totalAmount', 'note', 'clientNameSnapshot', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      // Subcollection: Payment & Abono Records
      match /payments/{paymentId} {
        allow get: if isOwner(userId) && isValidId(paymentId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(paymentId) &&
                         isValidPaymentRecord(incoming(), userId) &&
                         exists(/databases/$(database)/documents/users/$(userId)/clients/$(incoming().clientId));

        allow update: if isOwner(userId) &&
                         isValidId(paymentId) &&
                         isValidPaymentRecord(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().clientId == existing().clientId &&
                         incoming().createdAt == existing().createdAt && (
                           // Action: Correct payment record
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'dateEpochDay', 'amount', 'method', 'paymentType', 'note', 'clientNameSnapshot', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(paymentId);
      }
    }
  }
}
